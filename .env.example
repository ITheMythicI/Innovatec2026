# ==============================================================================
# Innovatec 2026 - Environment Variables Example
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#   cp .env.example backend/.env
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=api

# Database Configuration (Docker Compose & PostgreSQL + PostGIS)
POSTGRES_USER=innovatec_user
POSTGRES_PASSWORD=innovatec_password
POSTGRES_DB=innovatec_db
POSTGRES_PORT=5432

# Prisma Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://innovatec_user:innovatec_password@localhost:5432/innovatec_db?schema=public"

# Security & Authentication (JWT & RBAC)
JWT_SECRET=super_secret_jwt_key_innovatec_change_in_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Mobile API Endpoint (for reference / mobile configuration)
MOBILE_API_BASE_URL="http://10.0.2.2:3001/api" # 10.0.2.2 is localhost for Android Emulator
